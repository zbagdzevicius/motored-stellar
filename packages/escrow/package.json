{
  "name": "@motored-stellar/escrow",
  "version": "0.9.0",
  "description": "Trustless Work v1 single-release escrow client in EURC: lifecycle, guard-authorised release service, event reader and the fee, cap, rounding and refund rules (SCF D1, D3b, D6).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "17.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
