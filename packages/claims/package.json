{
  "name": "@motored-stellar/claims",
  "version": "0.8.0",
  "description": "Delivery claims for the escrow guard: claim leaf, hourly Merkle batches, registry anchoring, public re-check and TTL upkeep (SCF D6).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "vectors": "node test/gen-vectors.mjs > test/vectors.json"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "17.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
